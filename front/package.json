{
  "name": "myservices-front",
  "private": true,
  "version": "0.11.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "../scripts/dev.sh",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "test:cov": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary --coverage.include='src/**' --coverage.exclude='src/**/*.test.*'"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
