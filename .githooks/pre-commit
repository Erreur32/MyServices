#!/usr/bin/env bash
# Avant commit : aucune donnée sensible dans l'index, syntaxe des scripts. Installation : scripts/install-hooks.sh
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "━━━ pre-commit : garde-fou ━━━"
python3 scripts/safety.py --staged || exit 1
mapfile -t py < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ ${#py[@]} -gt 0 ] && { python3 -m py_compile "${py[@]}" || exit 1; echo "  ✓ Python : syntaxe"; }
mapfile -t sh < <(git diff --cached --name-only --diff-filter=ACMR -- '*.sh' .githooks)
if [ ${#sh[@]} -gt 0 ] && command -v shellcheck >/dev/null; then shellcheck -S warning "${sh[@]}" || exit 1; echo "  ✓ shellcheck"; fi
exit 0
