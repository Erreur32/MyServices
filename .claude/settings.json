{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/claude-guard.py\"", "timeout": 10 }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "open-code-review@open-code-review": true,
    "todo-projet@erreur32-mods": true,
    "suivi@erreur32-mods": true,
    "plan-progress@erreur32-mods": true,
    "gitstat@erreur32-mods": true,
    "aide@erreur32-mods": true,
    "php-lsp@claude-plugins-official": false,
    "maj-ia@erreur32-mods": false
  },
  "skillOverrides": {
    "ha-on": "off",
    "ha-off": "off",
    "maj-infra-ia": "off",
    "archify-review": "off",
    "cowork-plugin-management:cowork-plugin-customizer": "off",
    "cowork-plugin-management:create-cowork-plugin": "off",
    "design:accessibility-review": "off",
    "design:design-critique": "off",
    "design:design-handoff": "off",
    "design:design-system": "off",
    "design:research-synthesis": "off",
    "design:user-research": "off",
    "design:ux-copy": "off"
  }
}
