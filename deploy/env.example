# Save next to docker-compose.yaml as ".env" to change settings without editing the compose file:
#     curl -fsSLo .env https://raw.githubusercontent.com/Erreur32/MyServices/docker/deploy/env.example
#
# Port the app listens on (the page is at http://<host IP>:<port>/). Default 8090.
# The container uses the host network, so this is THE port to change: a "ports:" mapping would do nothing.
# Check first that it is free:  ss -ltnp | grep 8095
MYSERVICES_PORT=8090
