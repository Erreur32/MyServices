# MyServices : API du bouton ⟳ (127.0.0.1 seulement, nginx fait l'accès LAN).
# Ne lance rien elle-même : elle touche /var/lib/myservices-refresh/trigger, myservices-refresh.path fait le reste.
[Unit]
Description=MyServices : API du bouton Rafraîchir
After=network.target

[Service]
Type=simple
User=@API_USER@
Environment=REFRESH_HOST=127.0.0.1
Environment=REFRESH_PORT=@API_PORT@
Environment=REFRESH_COOLDOWN=300
Environment=MYSERVICES_WEB_DIR=@WEB_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=myservices-refresh
StateDirectoryMode=0755
ExecStart=@PYTHON@ @DIR@/refresh-api.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
