# MyServices : santé des machines (health.py), lecture seule, sans LLM.
# Root : mêmes clés SSH et alias que le collecteur ; sorties rendues au propriétaire du projet.
[Unit]
Description=MyServices : santé des machines -> health/stats.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON@ @DIR@/health.py
ExecStartPost=/bin/chown -R @OWNER@ @WEB_DIR@/health
TimeoutStartSec=10min
Nice=5
