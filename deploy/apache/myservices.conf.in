# MyServices : page + API du bouton ⟳. Installé dans /etc/apache2/conf-available/ par install.sh --apache,
# activé par a2enconf : la page répond sur /myservices/ de tous les sites d'Apache, réservée au réseau local.
# Pas de limite de débit comme avec nginx : l'API impose déjà 5 min entre deux passages.
Alias /myservices/ @WEB_DIR@/
<Directory @WEB_DIR@>
    Require ip @LAN_CIDR@ 127.0.0.1
    Options -Indexes
    DirectoryIndex index.html
    Header always set Cache-Control "no-cache, must-revalidate"
</Directory>

# X-Forwarded-Host (ajouté par mod_proxy) sert au contrôle d'origine de l'API, X-Real-IP à son journal
<Location /myservices/api/>
    Require ip @LAN_CIDR@ 127.0.0.1
    RequestHeader set X-Real-IP "%{REMOTE_ADDR}s"
    ProxyPass http://127.0.0.1:@API_PORT@/ timeout=15
    ProxyPassReverse http://127.0.0.1:@API_PORT@/
</Location>
